{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env*",
    "infra/**"
  ],
  "globalPassThroughEnv": [
    "CI",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "DATABASE_PATH",
    "RABBITMQ_URL",
    "REDIS_URL",
    "API_ADDR",
    "GO_API_URL",
    "GO_CUTOVER",
    "SENTRY_*",
    "LANGFUSE_*",
    "RUNNINGHUB_*",
    "ARK_*",
    "GEMINI_*",
    "OSS_*",
    "AGENT_*",
    "GENERATION_CONFIG_PATH",
    "SCRIPT_CONCURRENCY",
    "GOOGLE_API_KEY",
    "DEFAULT_API_KEY",
    "API_BASE_URL",
    "APP_ENV",
    "VITE_*",
    "NEXT_PUBLIC_*",
    "FFPROBE_PATH"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "bin/**",
        "dist/**"
      ],
      "env": [
        "VITE_*",
        "NEXT_PUBLIC_*",
        "SENTRY_*"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "cache": false
    },
    "dev:all": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
