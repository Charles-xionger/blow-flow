# Existing repository-level .env.local remains supported by normal launch scripts.
# Provider and OSS variables retain their existing names.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_RELEASE=
APP_ENV=development
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Personal Skill upload policy (MiB). Defaults: package 100, each file 20,
# expanded ZIP contents 200. Invalid or non-positive values use the defaults.
SKILL_UPLOAD_PACKAGE_MB=100
SKILL_UPLOAD_FILE_MB=20
SKILL_UPLOAD_EXPANDED_MB=200
