{
  "name": "@blow-flow/api",
  "private": true,
  "scripts": {
    "dev": "go run ./cmd/server",
    "dev:all": "go run ./cmd/server",
    "admin:setup": "go run ./cmd/local-admin-setup",
    "build": "go build -o bin/api ./cmd/server",
    "typecheck": "go vet ./...",
    "lint": "node ../../scripts/go-format.mjs",
    "test": "go test -race -count=1 ./...",
    "test:integration": "go test -race -count=1 -tags=integration ./internal/...",
    "test:e2e": "node --test tests/server.test.mjs",
    "db:migrate": "go run ./cmd/migrate"
  }
}
