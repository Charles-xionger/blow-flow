# Export these variables before starting Go. No automatic secret-file loading.
API_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://ai_flow:ai_flow_local@127.0.0.1:15432/ai_flow?sslmode=disable
APP_ENV=development
SENTRY_DSN=
SENTRY_RELEASE=
# Dedicated disposable test database only; never a production URL.
TEST_DATABASE_URL=
# Hosted identity provider. The audience must match the API access token audience.
OIDC_ISSUER=
OIDC_AUDIENCE=
# Selected provider JWT profile. Configure at least one MFA mapping.
OIDC_MFA_AMR=mfa
OIDC_ADMIN_ACR=
# External OIDC subject promoted only when its local account is first created.
INITIAL_ADMIN_SUBJECT=
