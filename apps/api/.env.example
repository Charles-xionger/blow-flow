# Local pnpm dev/worker scripts load root .env.local, then apps/api/.env.local;
# exported shell variables override both. Production Go binaries read process env.
API_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://ai_flow:ai_flow_local@127.0.0.1:15432/ai_flow?sslmode=disable
APP_ENV=development
SENTRY_DSN=
SENTRY_RELEASE=
# Dedicated disposable test database only; never a production URL.
TEST_DATABASE_URL=
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:15672/
TEST_RABBITMQ_URL=
REDIS_URL=redis://127.0.0.1:16379/0
TEST_REDIS_URL=
RUNNINGHUB_BASE_URL=
RUNNINGHUB_API_KEY=
ARK_API_KEY=
ARK_BASE_URL=
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_BASE_URL=
SCRIPT_CONCURRENCY=5
SCRIPT_MAX_QUEUED_PER_USER=100
# Comma-separated exact HTTPS hostnames for imported owned image URLs.
SCRIPT_ASSET_HOSTS=
OSS_REGION=
OSS_BUCKET_NAME=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Local administrator login. Run `pnpm admin:setup` to generate these secrets locally.
ADMIN_AUTH_EMAIL=
ADMIN_AUTH_PASSWORD_HASH=
AUTH_SIGNING_KEY=
# Base64-encoded random 32+ byte key for the internal Pi Runner claim endpoint.
AGENT_RUNNER_KEY=
# Controlled Go Agent API smoke tests only; product routing stays on Next.js.
AGENT_GO_EXPERIMENTAL_COMMANDS=0
# CLI-only when provisioning a verified creator account; do not leave set in the API process.
CREATOR_SETUP_PASSWORD=
