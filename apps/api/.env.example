# Export these variables before starting Go. No automatic secret-file loading.
API_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://ai_flow:ai_flow_local@127.0.0.1:15432/ai_flow?sslmode=disable
APP_ENV=development
SENTRY_DSN=
SENTRY_RELEASE=
# Dedicated disposable test database only; never a production URL.
TEST_DATABASE_URL=
# Local administrator login. Run `pnpm admin:setup` to generate these secrets locally.
ADMIN_AUTH_EMAIL=
ADMIN_AUTH_PASSWORD_HASH=
AUTH_SIGNING_KEY=
