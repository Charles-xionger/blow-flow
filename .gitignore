# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite runtime files
/data/*.db
/data/*.db-wal
/data/*.db-shm
/data/*.db-journal

.agents

.claude


.next-canvas-test/
/test-results/
/playwright-report/

.next-canvas-perf/
.scratch/canvas-drag-performance/measurements/

# Local Langfuse (scripts/setup-langfuse.sh): compose files and generated secrets
.langfuse/

# Monorepo build and local runtime output
**/node_modules/
**/.turbo/
**/.next*/
**/coverage/
**/test-results/
**/playwright-report/
**/bin/
**/data/*.db*
!**/.env.example
packages/evals/results/
**/.langfuse/
